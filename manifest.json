{
  "manifest_version": 3,
  "name": "Dev Tools Kit",
  "version": "1.0.0",
  "description": "JSON formatter, Base64 encoder/decoder and color picker in one popup.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dev Tools Kit",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}